{
  "name": "penpost",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "db:migrate:local": "wrangler d1 migrations apply penpost-solver --local --config worker/wrangler.toml",
    "db:migrate:remote": "wrangler d1 migrations apply penpost-solver --remote --config worker/wrangler.toml"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@types/node": "^22.20.7",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "wrangler": "^4.168.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0"
  }
}
